    {
      "id": "sat_sc_0001",
      "type": "single_choice",
      "difficulty": 4,
      "tags": [
        "sentence_completion",
        "sat"
      ],
      "payload": {
        "question": "Although the scientist's theory was initially ___, it eventually gained widespread acceptance after extensive testing.",
        "options": [
          "dismissed",
          "controversial",
          "celebrated",
          "endorsed",
          "validated"
        ],
        "answer_index": 1,
        "explanation": "Although 提示转折，后句为「gained widespread acceptance」，故空格应填其反义；controversial「有争议的」符合；celebrated/endorsed/validated 与后句同向，dismissed 语义过强且与后句「eventually」搭配不当。"
      }
    },
    {
      "id": "sat_sc_0002",
      "type": "single_choice",
      "difficulty": 4,
      "tags": [
        "sentence_completion",
        "sat"
      ],
      "payload": {
        "question": "The author's tone in the passage is best described as ___, given her dry wit and understated criticism of the bureaucracy.",
        "options": [
          "solemn",
          "satirical",
          "melodramatic",
          "earnest",
          "eulogistic"
        ],
        "answer_index": 1,
        "explanation": "satirical 意为「讽刺的」，与「dry wit」和「understated criticism」相符；solemn/earnest 均为严肃认真，melodramatic 过于夸张，eulogistic 为颂扬，均不符。"
      }
    },
    {
      "id": "sat_sc_0003",
      "type": "single_choice",
      "difficulty": 4,
      "tags": [
        "sentence_completion",
        "sat"
      ],
      "payload": {
